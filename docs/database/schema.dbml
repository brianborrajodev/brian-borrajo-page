Table users {
  id uuid [pk]
  provider varchar [not null, note: 'github | linkedin']
  provider_id varchar [not null]
  display_name varchar
  email varchar
  avatar_url varchar
  created_at timestamp [default: `now()`]

  indexes {
    (provider, provider_id) [unique]
  }
}

Table projects {
  id uuid [pk]
  title varchar [not null]
  description text
  repo_url varchar
  likes_count int [default: 0]
  created_at timestamp [default: `now()`]
}

Table likes {
  id uuid [pk]
  project_id uuid [not null]
  user_id uuid [not null]
  created_at timestamp [default: `now()`]

  indexes {
    (project_id, user_id) [unique]
  }
}

Table comments {
  id uuid [pk]
  project_id uuid [not null]
  user_id uuid [not null]
  text varchar [not null]
  created_at timestamp [default: `now()`]
}

Ref: likes.user_id > users.id
Ref: likes.project_id > projects.id
Ref: comments.user_id > users.id
Ref: comments.project_id > projects.id