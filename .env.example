# PostgreSQL (usado por el contenedor db y por la API Flask)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
# Opcional: si se define, tiene prioridad sobre los valores anteriores dentro de la API
# DATABASE_URL=postgresql://portfolio:portfolio@db:5432/portfolio

# Flask
SECRET_KEY=cambia-esta-clave-en-desarrollo
FLASK_DEBUG=1


# OAuth (rellenar cuando se implemente el inicio de sesión)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# URLs de los servicios (todas se consumen desde este archivo)
# FRONTEND_URL es el único origen permitido por CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Vite solo expone al navegador las variables que empiezan por VITE_
VITE_API_URL=http://localhost:5000
