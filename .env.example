# PostgreSQL (todos estos valores son obligatorios)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
POSTGRES_EXPOSED_PORT=5432
POSTGRES_HOST=db
POSTGRES_HEALTHCHECK_HOST=127.0.0.1

# Flask
SECRET_KEY=cambia-esta-clave-en-desarrollo
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
BACKEND_EXPOSED_PORT=5000

# OAuth (rellenar cuando se implemente el inicio de sesión)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# URLs de los servicios (todas se consumen desde este archivo)
# FRONTEND_URL es el único origen permitido por CORS
FRONTEND_URL=http://localhost:5173
VITE_HOST=0.0.0.0
VITE_PORT=5173
FRONTEND_EXPOSED_PORT=5173
# Vite solo expone al navegador las variables que empiezan por VITE_.
VITE_API_URL=http://localhost:5000
